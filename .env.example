# Database: default connects to local Docker PostgreSQL (started via `npm run setup` or `docker compose up -d`)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lazyfolio"

NODE_ENV="development"

# Better Auth Secret: arbitrary 32+ char secret for development cookies/tokens
BETTER_AUTH_SECRET="insecure-dev-secret-do-not-use-in-production-12345"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Enable One-Click Dev Login on /auth (no OAuth credentials required)
NEXT_PUBLIC_ENABLE_DEV_LOGIN="true"

# OAuth Providers (leave as "mock" for local dev; use Dev Login on /auth)
GOOGLE_CLIENT_ID="mock"
GOOGLE_CLIENT_SECRET="mock"
GITHUB_CLIENT_ID="mock"
GITHUB_CLIENT_SECRET="mock"

# Cloudinary (leave as "mock" for local dev; uploads will save locally to /public/uploads)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="mock"
NEXT_PUBLIC_CLOUDINARY_API_KEY="mock"
NEXT_PUBLIC_CLOUDINARY_API_SECRET="mock"

# Dodo Payments (leave as "mock" for local dev; clicking upgrade unlocks features automatically)
DODO_PAYMENTS_API_KEY="mock"
DODO_PAYMENTS_WEBHOOK_KEY="mock"
DODO_PAYMENTS_ARTICLE_MONTHLY_PRODUCT_ID="p_mock_monthly"
DODO_PAYMENTS_ARTICLE_YEARLY_PRODUCT_ID="p_mock_yearly"
DODO_PAYMENTS_ARTICLE_LIFETIME_PRODUCT_ID="p_mock_lifetime"
DODO_PAYMENTS_ENVIRONMENT="test_mode"

# (Optional) Insights Microservice Integration
# When unset or unreachable in dev, the dashboard uses mock analytics automatically
INSIGHTS_SERVICE_URL="http://localhost:8787"
INSIGHTS_SERVICE_SECRET="super-secret-service-token-12345"
VISITOR_HASH_SALT="random-salt-string-for-daily-ip-hashing"
